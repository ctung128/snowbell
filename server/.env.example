# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=3001

# Exact origin of the deployed frontend (no trailing slash), e.g. https://snowbellphoto.com
# During local development this is typically http://127.0.0.1:5500 or http://localhost:5500
ALLOWED_ORIGIN=http://localhost:5500

# Where contact-form inquiries are delivered
CONTACT_TO_EMAIL=you@example.com
# Optional: defaults to SMTP_USER if not set
CONTACT_FROM_EMAIL=

# SMTP credentials used to send the inquiry email (e.g. a Gmail app password,
# or credentials from your email/hosting provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
