# Copy this file to .env and fill in real values. Never commit .env.

# Port the API listens on
PORT=3001

# Exact origin of the deployed frontend (no trailing slash), e.g. https://snowbellphoto.com
# During local development this is typically http://127.0.0.1:5500 or http://localhost:5500
ALLOWED_ORIGIN=http://localhost:5500

# Where contact-form inquiries are delivered
CONTACT_TO_EMAIL=you@example.com
# Optional: defaults to Resend's sandbox sender (onboarding@resend.dev) if not
# set. Swap for an address on your own domain once you've verified one with
# Resend (https://resend.com/docs/dashboard/domains/introduction).
CONTACT_FROM_EMAIL=

# API key for sending the inquiry email via Resend's HTTPS API
# (https://resend.com — free tier covers a contact form easily). Sent over
# HTTPS rather than raw SMTP, since some hosts block outbound SMTP ports.
RESEND_API_KEY=
